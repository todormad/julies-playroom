{
  "redirects": [
    {
      "source": "/astro-buddy-jump",
      "destination": "/games/astro-buddy-jump/",
      "permanent": true
    },
    {
      "source": "/games/lost-robot-quest/lost-robot-quest.html",
      "destination": "/games/lost-robot-quest/",
      "permanent": true
    },
    {
      "source": "/poems",
      "destination": "/poems/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/poems/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
